      \        if len(self.recent_freqs) > self.stability_count:\n            self.recent_freqs.pop(0)\n\
      \        if len(self.recent_freqs) < self.stability_count:\n            self.bpm\
      \ = 0.0\n            return\n        lo, hi = min(self.recent_freqs), max(self.recent_freqs)\n\
      \        center = float(np.mean(self.recent_freqs))\n        if (hi - lo) >\
      \ self.stability_tol * center:\n            self.bpm = 0.0\n            return\n\
      \n        self.bpm = center * 60.0\n"
    affinity: ''
    alias: ''
    comment: ''
    f_high: resp_high
    f_low: resp_low
    maxoutbuf: '0'
    min_amplitude: min_amplitude
    minoutbuf: '0'
    samp_rate: rate2
    snr_ratio: snr_ratio
    stability_count: '5'
    stability_tol: '0.15'
    update_sec: '1.0'
    window_sec: '20.0'
  states:
    _io_cache: ('Rate Estimator (BPM)', 'blk', [('samp_rate', '20.0'), ('f_low', '0.1'),
      ('f_high', '0.5'), ('window_sec', '15.0'), ('update_sec', '1.0'), ('min_amplitude',
      '0.05'), ('snr_ratio', '8.0'), ('stability_count', '5'), ('stability_tol', '0.15')],
      [('0', 'float', 1)], [('0', 'float', 1)], 'Windowed-FFT peak-rate estimator
      with amplitude + local-SNR +\n    frequency-stability gating (float in -> float
      BPM out)', ['f_high', 'f_low', 'min_amplitude', 'samp_rate', 'snr_ratio', 'stability_count',
      'stability_tol'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [2056, 236.0]
    rotation: 0
    state: enabled
